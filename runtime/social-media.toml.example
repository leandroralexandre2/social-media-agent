schema_version = 1

[company]
name = "CHANGE_ME"
aliases = []

[monitor]
max_items_per_platform = 10
max_browser_actions_per_platform = 20

[browser]
# Reuse one healthy Camoufox session instead of creating a new login per draft.
reuse_authenticated_session = true
keep_session_open_minutes = 120

[publishing]
# Space separate verified publications. X error 344 has its own bounded retry.
x_min_interval_seconds = 60
linkedin_min_interval_seconds = 45
x_max_publications_per_24h = 25
linkedin_max_publications_per_24h = 25
x_error_344_backoff_seconds = [12, 20]
# A short deterministic settle delay lets React process the final input event.
post_fill_settle_seconds = 2

[platforms.x]
enabled = true
notifications_url = "https://x.com/notifications"
search_terms = []

[platforms.linkedin]
enabled = true
notifications_url = "https://www.linkedin.com/notifications/"
search_terms = []

[persona]
description = "Professional, human, concise, and lightly humorous when the context allows it."
languages = ["en"]
use_emojis = "sparingly"
forbidden_topics = [
  "price or delivery promises",
  "personal data",
  "political positions without authorization",
  "legal or financial advice",
]

[safety]
auto_publish = false
require_approval = true
escalate_complaints = true
escalate_crisis = true
