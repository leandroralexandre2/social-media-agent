# Destination in Messages: E.164 phone or Apple ID email.
SOCIAL_MESSAGES_RECIPIENT=

# Trusted Plow chat where draft approvals are received (cht_...).
SOCIAL_APPROVAL_CHAT_UID=

# macOS wall-clock timezone used by the scheduler.
TZ=America/Sao_Paulo

# Optional scheduler expression used by scripts/enable-social-monitor.sh.
SOCIAL_POLL_SCHEDULE=every 1h
